import React, { useState, useEffect } from "react";
import {
  Database,
  Search,
  Filter,
  Terminal,
  Code2,
  Plus,
  Play,
  RefreshCw,
  Zap,
  ShieldAlert,
  Sliders,
  CheckCircle2,
  X,
  Radio,
} from "lucide-react";
import { SiemLog } from "../../types";

interface SiemLogsViewProps {
  logs: SiemLog[];
}

const normalizeLog = (log: any) => ({
  ...log,
  sourceType: log.sourceType || log.logSource || "Syslog",
  logSource: log.logSource || log.sourceType || "Syslog",
  sourceIp: log.sourceIp || log.ip || "127.0.0.1",
  ip: log.ip || log.sourceIp || "127.0.0.1",
  user: log.user || "system",
  category: log.category || "General",
  rawJson: log.rawJson || (log.ecs ? JSON.stringify(log.ecs) : JSON.stringify(log)),
});

export const SiemLogsView: React.FC<SiemLogsViewProps> = ({ logs: propsLogs }) => {
  const [logs, setLogs] = useState<any[]>(() => (propsLogs || []).map(normalizeLog));
  const [stats, setStats] = useState<any>(null);
  const [rules, setRules] = useState<any[]>([]);
  const [searchQuery, setSearchQuery] = useState<string>("");
  const [selectedSource, setSelectedSource] = useState<string>("ALL");
  const [selectedLevel, setSelectedLevel] = useState<string>("ALL");
  const [selectedLog, setSelectedLog] = useState<any | null>(null);
  const [activeTab, setActiveTab] = useState<"logs" | "rules">("logs");
  const [isLiveStreaming, setIsLiveStreaming] = useState<boolean>(true);
  const [isLoading, setIsLoading] = useState<boolean>(false);

  // Sync propsLogs into local state
  useEffect(() => {
    if (propsLogs && propsLogs.length > 0) {
      setLogs((prev) => {
        const map = new Map();
        for (const item of [...prev, ...propsLogs.map(normalizeLog)]) {
          map.set(item.id, item);
        }
        return Array.from(map.values());
      });
    }
  }, [propsLogs]);

  // Ingest Modal State
  const [showIngestModal, setShowIngestModal] = useState<boolean>(false);
  const [ingestForm, setIngestForm] = useState({
    message: "Failed password for root from 185.220.101.99 port 51102 ssh2",
    level: "WARN",
    sourceType: "Syslog",
    host: "app-prod-02",
    sourceIp: "185.220.101.99",
    user: "root",
    category: "Authentication",
    eventId: "4625",
  });

  // New Rule Modal State
  const [showRuleModal, setShowRuleModal] = useState<boolean>(false);
  const [ruleForm, setRuleForm] = useState({
    id: `RULE-${Math.floor(100 + Math.random() * 900)}`,
    title: "Suspicious PowerShell Execution",
    description: "Detects encoded PowerShell commands",
    severity: "HIGH",
    logSource: "WindowsEvent",
    conditionKql: "level:WARN AND message:powershell",
    timeWindowSeconds: 60,
    thresholdCount: 2,
    mitreTactic: "Execution",
    mitreTechnique: "T1059 - Command Scripting",
    enabled: true,
  });

  // Fetch Logs from Backend REST API
  const fetchLogs = async () => {
    setIsLoading(true);
    try {
      const queryParams = new URLSearchParams();
      if (searchQuery) queryParams.set("kql", searchQuery);
      if (selectedLevel !== "ALL") queryParams.set("level", selectedLevel);
      if (selectedSource !== "ALL") queryParams.set("sourceType", selectedSource);

      const res = await fetch(`/api/siem/logs?${queryParams.toString()}`);
      if (res.ok) {
        const data = await res.json();
        const apiLogs = (data.logs || []).map(normalizeLog);
        const pLogs = (propsLogs || []).map(normalizeLog);
        
        const map = new Map();
        for (const item of [...apiLogs, ...pLogs]) {
          map.set(item.id, item);
        }
        const combined = Array.from(map.values());
        setLogs(combined);
        if (combined.length > 0 && !selectedLog) {
          setSelectedLog(combined[0]);
        }
      } else if (propsLogs && propsLogs.length > 0) {
        const pLogs = propsLogs.map(normalizeLog);
        setLogs(pLogs);
        if (!selectedLog) setSelectedLog(pLogs[0]);
      }
    } catch (err) {
      console.error("Failed to fetch SIEM logs:", err);
      if (propsLogs && propsLogs.length > 0) {
        const pLogs = propsLogs.map(normalizeLog);
        setLogs(pLogs);
        if (!selectedLog) setSelectedLog(pLogs[0]);
      }
    } finally {
      setIsLoading(false);
    }
  };

  // Fetch Telemetry Statistics
  const fetchStats = async () => {
    try {
      const res = await fetch("/api/siem/stats");
      if (res.ok) {
        const data = await res.json();
        setStats(data);
      }
    } catch (err) {
      console.error("Failed to fetch SIEM stats:", err);
    }
  };

  // Fetch Rules
  const fetchRules = async () => {
    try {
      const res = await fetch("/api/siem/rules");
      if (res.ok) {
        const data = await res.json();
        setRules(data);
      }
    } catch (err) {
      console.error("Failed to fetch SIEM rules:", err);
    }
  };

  useEffect(() => {
    fetchLogs();
    fetchStats();
    fetchRules();
  }, [selectedSource, selectedLevel]);

  // Handle KQL Search
  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    fetchLogs();
  };

  // Server-Sent Events (SSE) Live Stream Subscription
  useEffect(() => {
    if (!isLiveStreaming) return;

    const eventSource = new EventSource("/api/siem/stream");

    eventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        if (data.type === "log") {
          setLogs((prev) => [data.payload, ...prev.slice(0, 99)]);
          fetchStats();
        }
      } catch (e) {
        console.error("SSE parse error", e);
      }
    };

    return () => {
      eventSource.close();
    };
  }, [isLiveStreaming]);

  // Handle Ingest Submit
  const handleIngestSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      const res = await fetch("/api/siem/ingest", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(ingestForm),
      });

      if (res.ok) {
        setShowIngestModal(false);
        fetchLogs();
        fetchStats();
      }
    } catch (err) {
      console.error("Failed to ingest log:", err);
    }
  };

  // Handle Create Rule Submit
  const handleRuleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      const res = await fetch("/api/siem/rules", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(ruleForm),
      });

      if (res.ok) {
        setShowRuleModal(false);
        fetchRules();
      }
    } catch (err) {
      console.error("Failed to create rule:", err);
    }
  };

  return (
    <div className="p-6 space-y-6 text-slate-100">
      {/* Header Banner */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 flex flex-wrap items-center justify-between gap-4 shadow-lg">
        <div className="flex items-center gap-3">
          <div className="p-3 bg-blue-500/10 border border-blue-500/30 rounded-xl text-blue-400">
            <Database className="w-6 h-6" />
          </div>
          <div>
            <div className="flex items-center gap-3">
              <h2 className="font-bold text-base text-slate-100">
                SIEM Log Engine & Correlation Pipeline
              </h2>
              <span className="px-2 py-0.5 bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold rounded-full flex items-center gap-1">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                LIVE PRODUCTION SERVICE
              </span>
            </div>
            <p className="text-xs text-slate-400 mt-0.5">
              Ingestion API, Elastic Common Schema (ECS), Kafka Streaming & KQL Search
            </p>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-3">
          <button
            onClick={() => setIsLiveStreaming(!isLiveStreaming)}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold font-mono border flex items-center gap-2 transition-all ${
              isLiveStreaming
                ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300"
                : "bg-slate-800 border-slate-700 text-slate-400"
            }`}
          >
            <Radio className={`w-3.5 h-3.5 ${isLiveStreaming ? "animate-pulse text-emerald-400" : ""}`} />
            {isLiveStreaming ? "SSE Live Streaming" : "Stream Paused"}
          </button>

          <span className="px-3 py-1.5 bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-bold rounded-lg font-mono">
            Ingestion: {stats?.ingestionRatePerSec || 25480} ev/s
          </span>

          <button
            onClick={() => setShowIngestModal(true)}
            className="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-lg flex items-center gap-1.5 shadow-md transition-all"
          >
            <Plus className="w-3.5 h-3.5" /> Ingest Test Log
          </button>
        </div>
      </div>

      {/* Tabs: Logs Query vs Detection Rules */}
      <div className="flex items-center gap-4 border-b border-slate-800 pb-2">
        <button
          onClick={() => setActiveTab("logs")}
          className={`px-4 py-2 text-xs font-bold rounded-lg flex items-center gap-2 transition-colors ${
            activeTab === "logs"
              ? "bg-blue-600 text-white"
              : "bg-slate-900 border border-slate-800 text-slate-400 hover:text-slate-200"
          }`}
        >
          <Terminal className="w-4 h-4" /> Log Telemetry & KQL Search
        </button>

        <button
          onClick={() => setActiveTab("rules")}
          className={`px-4 py-2 text-xs font-bold rounded-lg flex items-center gap-2 transition-colors ${
            activeTab === "rules"
              ? "bg-blue-600 text-white"
              : "bg-slate-900 border border-slate-800 text-slate-400 hover:text-slate-200"
          }`}
        >
          <Sliders className="w-4 h-4" /> Correlation Rules ({rules.length})
        </button>
      </div>

      {activeTab === "logs" ? (
        <>
          {/* Query Bar & Filters */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg space-y-3">
            <form onSubmit={handleSearch} className="flex flex-wrap items-center gap-3">
              {/* KQL Search Field */}
              <div className="relative flex-1 min-w-[280px]">
                <Search className="w-4 h-4 text-slate-400 absolute left-3 top-3" />
                <input
                  type="text"
                  placeholder="Execute KQL Query (e.g. level:WARN AND message:Failed or host:app-prod-01)..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg pl-9 pr-4 py-2 text-xs font-mono text-cyan-300 focus:outline-none focus:border-blue-500"
                />
              </div>

              {/* Log Source Filter */}
              <div className="flex items-center gap-2">
                <Filter className="w-4 h-4 text-slate-400" />
                <select
                  value={selectedSource}
                  onChange={(e) => setSelectedSource(e.target.value)}
                  className="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none font-mono"
                >
                  <option value="ALL">All Sources</option>
                  <option value="Syslog">Syslog</option>
                  <option value="WindowsEvent">Windows Security</option>
                  <option value="CloudTrail">AWS CloudTrail</option>
                  <option value="Kubernetes">Kubernetes Audit</option>
                  <option value="PaloAltoFirewall">PaloAlto Firewall</option>
                </select>

                <select
                  value={selectedLevel}
                  onChange={(e) => setSelectedLevel(e.target.value)}
                  className="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none font-mono"
                >
                  <option value="ALL">All Levels</option>
                  <option value="CRITICAL">CRITICAL</option>
                  <option value="ERROR">ERROR</option>
                  <option value="WARN">WARN</option>
                  <option value="INFO">INFO</option>
                </select>

                <button
                  type="submit"
                  className="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-bold font-mono flex items-center gap-1.5"
                >
                  <RefreshCw className={`w-3.5 h-3.5 ${isLoading ? "animate-spin" : ""}`} /> Query
                </button>
              </div>
            </form>
          </div>

          {/* Main Grid: Log Table + Log Payload Inspector */}
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {/* Left 2 Columns: SIEM Log Stream Table */}
            <div className="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-4">
              <div className="flex items-center justify-between pb-3 border-b border-slate-800">
                <h3 className="font-bold text-sm text-slate-100 flex items-center gap-2">
                  <Terminal className="w-4 h-4 text-blue-400" /> Live Ingested Logs
                </h3>
                <span className="text-xs text-slate-400 font-mono">
                  Showing {logs.length} indexed events
                </span>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse text-xs font-mono">
                  <thead>
                    <tr className="text-slate-400 border-b border-slate-800 bg-slate-950/50 uppercase text-[10px] tracking-wider font-semibold">
                      <th className="py-2.5 px-3">Timestamp</th>
                      <th className="py-2.5 px-3">Source</th>
                      <th className="py-2.5 px-3">Host & User</th>
                      <th className="py-2.5 px-3">Level</th>
                      <th className="py-2.5 px-3">Message</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60">
                    {logs.length === 0 ? (
                      <tr>
                        <td colSpan={5} className="py-8 text-center text-slate-500 font-sans">
                          No log records match your query filter.
                        </td>
                      </tr>
                    ) : (
                      logs.map((log) => (
                        <tr
                          key={log.id}
                          onClick={() => setSelectedLog(log)}
                          className={`cursor-pointer transition-colors ${
                            selectedLog?.id === log.id
                              ? "bg-blue-950/40 text-blue-200"
                              : "hover:bg-slate-800/40 text-slate-300"
                          }`}
                        >
                          <td className="py-2.5 px-3 whitespace-nowrap text-slate-400 text-[11px]">
                            {log.timestamp ? log.timestamp.split("T")[1]?.slice(0, 8) : "--"}
                          </td>

                          <td className="py-2.5 px-3 whitespace-nowrap">
                            <span className="font-bold text-slate-200">{log.sourceType || log.logSource}</span>
                          </td>

                          <td className="py-2.5 px-3 whitespace-nowrap">
                            <p className="text-slate-200 font-semibold">{log.host}</p>
                            <p className="text-slate-400 text-[10px]">{log.user || "system"}</p>
                          </td>

                          <td className="py-2.5 px-3 whitespace-nowrap">
                            <span
                              className={`px-1.5 py-0.5 rounded text-[10px] font-extrabold ${
                                log.level === "CRITICAL"
                                  ? "bg-rose-500/20 text-rose-400"
                                  : log.level === "ERROR"
                                  ? "bg-amber-500/20 text-amber-400"
                                  : log.level === "WARN"
                                  ? "bg-yellow-500/20 text-yellow-300"
                                  : "bg-blue-500/20 text-blue-300"
                              }`}
                            >
                              {log.level}
                            </span>
                          </td>

                          <td className="py-2.5 px-3 max-w-xs font-sans">
                            <p className="line-clamp-1 text-slate-300 text-[11px]">{log.message}</p>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Right 1 Column: Raw Log JSON Inspector */}
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-4">
              <div className="flex items-center justify-between pb-3 border-b border-slate-800">
                <h3 className="font-bold text-sm text-slate-100 flex items-center gap-2">
                  <Code2 className="w-4 h-4 text-cyan-400" /> Log Inspector & ECS Payload
                </h3>
                {selectedLog && (
                  <span className="text-[10px] font-mono text-cyan-400">{selectedLog.id}</span>
                )}
              </div>

              {selectedLog ? (
                <div className="space-y-4 text-xs">
                  <div className="p-3 bg-slate-950 border border-slate-800 rounded-lg space-y-1">
                    <p className="font-bold text-slate-200 text-sm">{selectedLog.sourceType || selectedLog.logSource}</p>
                    <p className="text-slate-300 text-[11px]">{selectedLog.message}</p>
                  </div>

                  <div className="grid grid-cols-2 gap-2 text-[11px] font-mono">
                    <div className="p-2 bg-slate-950 border border-slate-800 rounded">
                      <span className="text-slate-500 block text-[10px]">HOST</span>
                      <span className="text-slate-200 font-bold">{selectedLog.host}</span>
                    </div>
                    <div className="p-2 bg-slate-950 border border-slate-800 rounded">
                      <span className="text-slate-500 block text-[10px]">USER</span>
                      <span className="text-indigo-300 font-bold">{selectedLog.user || "system"}</span>
                    </div>
                    <div className="p-2 bg-slate-950 border border-slate-800 rounded">
                      <span className="text-slate-500 block text-[10px]">SOURCE IP</span>
                      <span className="text-rose-300 font-bold">{selectedLog.sourceIp || selectedLog.ip}</span>
                    </div>
                    <div className="p-2 bg-slate-950 border border-slate-800 rounded">
                      <span className="text-slate-500 block text-[10px]">CATEGORY</span>
                      <span className="text-cyan-300 font-bold">{selectedLog.category || "General"}</span>
                    </div>
                  </div>

                  {/* Raw JSON ECS Structure */}
                  <div className="space-y-1">
                    <p className="text-slate-400 font-bold text-[10px] uppercase">
                      Elastic Common Schema (ECS) Format:
                    </p>
                    <pre className="p-3 bg-slate-950 border border-slate-800 rounded-lg font-mono text-[10px] text-emerald-400 overflow-x-auto leading-relaxed max-h-80">
                      {JSON.stringify(selectedLog.ecs || (selectedLog.rawJson ? JSON.parse(typeof selectedLog.rawJson === 'string' ? selectedLog.rawJson : JSON.stringify(selectedLog.rawJson)) : selectedLog), null, 2)}
                    </pre>
                  </div>
                </div>
              ) : (
                <div className="py-16 text-center text-slate-500">
                  Select a log entry from the table to inspect details.
                </div>
              )}
            </div>
          </div>
        </>
      ) : (
        /* Correlation Rules Tab */
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-4">
          <div className="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <h3 className="font-bold text-sm text-slate-100 flex items-center gap-2">
                <Sliders className="w-4 h-4 text-blue-400" /> Active SIEM Correlation Engine Rules
              </h3>
              <p className="text-xs text-slate-400">
                Rules continuously evaluate incoming log streams and trigger security alerts
              </p>
            </div>
            <button
              onClick={() => setShowRuleModal(true)}
              className="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-lg flex items-center gap-1.5 shadow-md"
            >
              <Plus className="w-3.5 h-3.5" /> Create Correlation Rule
            </button>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {rules.map((rule) => (
              <div
                key={rule.id}
                className="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3 relative hover:border-slate-700 transition-colors"
              >
                <div className="flex items-center justify-between">
                  <span className="text-xs font-mono font-bold text-blue-400">{rule.id}</span>
                  <span
                    className={`px-2 py-0.5 rounded text-[10px] font-extrabold ${
                      rule.severity === "CRITICAL"
                        ? "bg-rose-500/20 text-rose-400"
                        : "bg-amber-500/20 text-amber-400"
                    }`}
                  >
                    {rule.severity}
                  </span>
                </div>

                <h4 className="font-bold text-sm text-slate-200">{rule.title}</h4>
                <p className="text-xs text-slate-400">{rule.description}</p>

                <div className="p-2.5 bg-slate-900 border border-slate-800 rounded-lg font-mono text-xs text-cyan-300">
                  <span className="text-[10px] text-slate-500 block">KQL MATCH CONDITION:</span>
                  {rule.conditionKql}
                </div>

                <div className="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800 font-mono">
                  <span>
                    Threshold: {rule.thresholdCount} events / {rule.timeWindowSeconds}s
                  </span>
                  <span className="text-indigo-400 font-semibold">{rule.mitreTechnique}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Manual Log Ingestion Modal */}
      {showIngestModal && (
        <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-slate-900 border border-slate-800 rounded-xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-bold text-slate-100 flex items-center gap-2">
                <Zap className="w-4 h-4 text-blue-400" /> Ingest Test Log Event
              </h3>
              <button
                onClick={() => setShowIngestModal(false)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleIngestSubmit} className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 font-bold mb-1">Raw Log Message</label>
                <textarea
                  rows={3}
                  value={ingestForm.message}
                  onChange={(e) => setIngestForm({ ...ingestForm, message: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200 font-mono focus:outline-none focus:border-blue-500"
                  required
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-slate-400 font-bold mb-1">Source Type</label>
                  <select
                    value={ingestForm.sourceType}
                    onChange={(e) => setIngestForm({ ...ingestForm, sourceType: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200"
                  >
                    <option value="Syslog">Syslog</option>
                    <option value="WindowsEvent">Windows Security</option>
                    <option value="CloudTrail">AWS CloudTrail</option>
                    <option value="Kubernetes">Kubernetes</option>
                  </select>
                </div>

                <div>
                  <label className="block text-slate-400 font-bold mb-1">Log Level</label>
                  <select
                    value={ingestForm.level}
                    onChange={(e) => setIngestForm({ ...ingestForm, level: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200"
                  >
                    <option value="INFO">INFO</option>
                    <option value="WARN">WARN</option>
                    <option value="ERROR">ERROR</option>
                    <option value="CRITICAL">CRITICAL</option>
                  </select>
                </div>

                <div>
                  <label className="block text-slate-400 font-bold mb-1">Host Name</label>
                  <input
                    type="text"
                    value={ingestForm.host}
                    onChange={(e) => setIngestForm({ ...ingestForm, host: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200 font-mono"
                  />
                </div>

                <div>
                  <label className="block text-slate-400 font-bold mb-1">Source IP</label>
                  <input
                    type="text"
                    value={ingestForm.sourceIp}
                    onChange={(e) => setIngestForm({ ...ingestForm, sourceIp: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200 font-mono"
                  />
                </div>
              </div>

              <div className="pt-3 flex items-center justify-end gap-2 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => setShowIngestModal(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-lg"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg shadow-md flex items-center gap-1.5"
                >
                  <Zap className="w-3.5 h-3.5" /> Ingest & Correlate
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Create Rule Modal */}
      {showRuleModal && (
        <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-slate-900 border border-slate-800 rounded-xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <h3 className="font-bold text-slate-100 flex items-center gap-2">
                <Sliders className="w-4 h-4 text-blue-400" /> Create SIEM Correlation Rule
              </h3>
              <button
                onClick={() => setShowRuleModal(false)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleRuleSubmit} className="space-y-3 text-xs">
              <div>
                <label className="block text-slate-400 font-bold mb-1">Rule Title</label>
                <input
                  type="text"
                  value={ruleForm.title}
                  onChange={(e) => setRuleForm({ ...ruleForm, title: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200"
                  required
                />
              </div>

              <div>
                <label className="block text-slate-400 font-bold mb-1">KQL Match Condition</label>
                <input
                  type="text"
                  value={ruleForm.conditionKql}
                  onChange={(e) => setRuleForm({ ...ruleForm, conditionKql: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-cyan-300 font-mono"
                  placeholder="e.g. level:WARN AND message:powershell"
                  required
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-slate-400 font-bold mb-1">Severity</label>
                  <select
                    value={ruleForm.severity}
                    onChange={(e) => setRuleForm({ ...ruleForm, severity: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200"
                  >
                    <option value="LOW">LOW</option>
                    <option value="MEDIUM">MEDIUM</option>
                    <option value="HIGH">HIGH</option>
                    <option value="CRITICAL">CRITICAL</option>
                  </select>
                </div>

                <div>
                  <label className="block text-slate-400 font-bold mb-1">Log Source</label>
                  <select
                    value={ruleForm.logSource}
                    onChange={(e) => setRuleForm({ ...ruleForm, logSource: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-slate-200"
                  >
                    <option value="ALL">ALL</option>
                    <option value="Syslog">Syslog</option>
                    <option value="WindowsEvent">Windows Security</option>
                    <option value="CloudTrail">AWS CloudTrail</option>
                    <option value="Kubernetes">Kubernetes</option>
                  </select>
                </div>
              </div>

              <div className="pt-3 flex items-center justify-end gap-2 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => setShowRuleModal(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-lg"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg shadow-md"
                >
                  Create Rule
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
