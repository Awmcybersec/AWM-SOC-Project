import { EventEmitter } from 'events';
import crypto from 'crypto';
import { GoogleGenAI } from '@google/genai';

// ============================================================================
// Types & Interfaces
// ============================================================================

export type TargetType = 'FIREWALL' | 'ENDPOINT' | 'IDENTITY' | 'THREAT_INTEL';
export type BusinessImpact = 'CRITICAL' | 'HIGH' | 'MEDIUM' | 'LOW';
export type AssetCriticality = 'CRITICAL' | 'HIGH' | 'MEDIUM' | 'LOW';
export type ThreatIntelReputation = 'MALICIOUS' | 'SUSPICIOUS' | 'UNKNOWN' | 'BENIGN';
export type ApprovalStatus = 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED' | 'MODIFIED' | 'AUTO_EXECUTED' | 'MONITORED';
export type BlockedEntityType = 
  | 'IP' | 'CIDR' | 'COUNTRY' | 'PORT' 
  | 'ENDPOINT' | 'PROCESS' | 'FILE' 
  | 'USER' | 'DOMAIN' | 'URL' | 'SHA256' | 'MD5' | 'JA3' | 'EMAIL';

export interface ResponsePolicy {
  id: string;
  name: string;
  target_type: TargetType;
  action_type: string;
  min_threat_score: number;
  min_confidence: number;
  auto_approve: boolean;
  enabled: boolean;
  created_at: string;
  updated_at: string;
}

export interface TimelineEvent {
  timestamp: string;
  source: string;
  description: string;
  severity: string;
}

export interface ApprovalRequest {
  id: string;
  alert_id: string;
  alert_title: string;
  threat_score: number;
  confidence_score: number;
  business_impact: BusinessImpact;
  mitre_mapping: string[];
  asset_criticality: AssetCriticality;
  threat_intel_reputation: ThreatIntelReputation;
  evidence: string;
  timeline: TimelineEvent[];
  ai_reasoning: string;
  risk_explanation: string;
  recommended_action: string;
  alternative_action: string;
  target_identifier: string;
  target_type: TargetType;
  status: ApprovalStatus;
  requested_at: string;
  decided_at?: string;
  decided_by?: string;
  modified_action?: string;
}

export interface ResponseAction {
  id: string;
  approval_request_id: string;
  target_type: TargetType;
  target_identifier: string;
  action_type: string;
  status: 'SUCCESS' | 'FAILED' | 'PENDING' | 'ROLLED_BACK';
  integration_system: string;
  executed_at: string;
  result_details: Record<string, any>;
}

export interface BlockedEntity {
  id: string;
  entity_type: BlockedEntityType;
  entity_value: string;
  reason: string;
  blocked_by: 'AUTO' | 'HUMAN_APPROVAL' | 'MANUAL';
  blocked_at: string;
  expires_at?: string | null;
  status: 'ACTIVE' | 'UNBLOCKED';
}

export interface ResponseAuditLog {
  id: string;
  timestamp: string;
  actor: string;
  action: string;
  target: string;
  details: string;
  hash: string;
}

export interface SecurityAlertInput {
  id?: string;
  title: string;
  category?: string;
  severity: 'Critical' | 'High' | 'Medium' | 'Low' | 'Info';
  sourceIp?: string;
  destinationIp?: string;
  user?: string;
  device?: string;
  description?: string;
  mitreTactic?: string;
  mitreTechniqueId?: string;
  iocHash?: string;
  score?: number;
  confidence?: number;
}

// ============================================================================
// Firewall Integration Drivers
// ============================================================================

export type FirewallType = 
  | 'WINDOWS_FIREWALL' 
  | 'LINUX_IPTABLES' 
  | 'NFTABLES' 
  | 'CISCO_ASA' 
  | 'FORTINET' 
  | 'PALO_ALTO' 
  | 'PFSENSE' 
  | 'GENERIC_REST';

export interface FirewallDriver {
  type: FirewallType;
  name: string;
  status: 'CONNECTED' | 'DISCONNECTED';
  blockIp: (ip: string, reason: string) => Promise<{ success: boolean; command: string }>;
  unblockIp: (ip: string) => Promise<{ success: boolean; command: string }>;
  blockCidr: (cidr: string) => Promise<{ success: boolean; command: string }>;
  blockCountry: (countryCode: string) => Promise<{ success: boolean; command: string }>;
  blockPort: (port: number, protocol: 'TCP' | 'UDP') => Promise<{ success: boolean; command: string }>;
  tempBlock: (ip: string, durationMinutes: number) => Promise<{ success: boolean; command: string }>;
}

// ============================================================================
// Autonomous Response & Human Approval Engine Class
// ============================================================================

export class AutonomousResponseEngine extends EventEmitter {
  private policies: Map<string, ResponsePolicy> = new Map();
  private approvalRequests: Map<string, ApprovalRequest> = new Map();
  private responseActions: ResponseAction[] = [];
  private blockedEntities: Map<string, BlockedEntity> = new Map();
  private auditLogs: ResponseAuditLog[] = [];
  private firewallDrivers: Map<FirewallType, FirewallDriver> = new Map();
  private aiClient: GoogleGenAI | null = null;

  constructor() {
  super();

  if (process.env.ENABLE_DEMO_DATA === "true") {
    this.seedDefaultPolicies();
    this.seedFirewallDrivers();
    this.seedMockData();
  }
}
  private initGemini() {
    if (process.env.GEMINI_API_KEY) {
      this.aiClient = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });
    }
  }

  // --------------------------------------------------------------------------
  // Seeders
  // --------------------------------------------------------------------------

  private seedDefaultPolicies() {
    return;
    const defaults: ResponsePolicy[] = [
      {
        id: 'POL-AUTO-001',
        name: 'Critical Threat Auto-Block & Containment',
        target_type: 'FIREWALL',
        action_type: 'BLOCK_IP',
        min_threat_score: 95,
        min_confidence: 95,
        auto_approve: true,
        enabled: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      },
      {
        id: 'POL-AUTO-002',
        name: 'Ransomware Endpoint Automated Isolation',
        target_type: 'ENDPOINT',
        action_type: 'ISOLATE_ENDPOINT',
        min_threat_score: 95,
        min_confidence: 95,
        auto_approve: true,
        enabled: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      },
      {
        id: 'POL-APPROVAL-001',
        name: 'High-Severity Suspicious Execution Approval',
        target_type: 'ENDPOINT',
        action_type: 'KILL_PROCESS',
        min_threat_score: 70,
        min_confidence: 70,
        auto_approve: false,
        enabled: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      },
      {
        id: 'POL-APPROVAL-002',
        name: 'Identity Compromise Account Lock Approval',
        target_type: 'IDENTITY',
        action_type: 'DISABLE_USER',
        min_threat_score: 75,
        min_confidence: 70,
        auto_approve: false,
        enabled: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      },
      {
        id: 'POL-INTEL-001',
        name: 'Threat Intel Automated IOC Blacklist',
        target_type: 'THREAT_INTEL',
        action_type: 'BLOCK_HASH',
        min_threat_score: 90,
        min_confidence: 85,
        auto_approve: true,
        enabled: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      },
    ];

    for (const pol of defaults) {
      this.policies.set(pol.id, pol);
    }
  }

  private seedFirewallDrivers() {
    const driverTypes: FirewallType[] = [
      'WINDOWS_FIREWALL',
      'LINUX_IPTABLES',
      'NFTABLES',
      'CISCO_ASA',
      'FORTINET',
      'PALO_ALTO',
      'PFSENSE',
      'GENERIC_REST',
    ];

    for (const type of driverTypes) {
      this.firewallDrivers.set(type, {
        type,
        name: this.getFirewallName(type),
        status: 'CONNECTED',
        blockIp: async (ip: string, reason: string) => {
          return {
            success: true,
            command: this.formatBlockCommand(type, ip, reason),
          };
        },
        unblockIp: async (ip: string) => {
          return {
            success: true,
            command: this.formatUnblockCommand(type, ip),
          };
        },
        blockCidr: async (cidr: string) => {
          return {
            success: true,
            command: `[${type}] BLOCK CIDR ${cidr}`,
          };
        },
        blockCountry: async (countryCode: string) => {
          return {
            success: true,
            command: `[${type}] BLOCK GEOCOUNTRY ${countryCode}`,
          };
        },
        blockPort: async (port: number, protocol: 'TCP' | 'UDP') => {
          return {
            success: true,
            command: `[${type}] BLOCK PORT ${protocol}/${port}`,
          };
        },
        tempBlock: async (ip: string, durationMinutes: number) => {
          return {
            success: true,
            command: `[${type}] TEMP BLOCK IP ${ip} FOR ${durationMinutes}m`,
          };
        },
      });
    }
  }

  private getFirewallName(type: FirewallType): string {
    switch (type) {
      case 'WINDOWS_FIREWALL': return 'Windows Defender Firewall Driver';
      case 'LINUX_IPTABLES': return 'Linux iptables Packet Filter';
      case 'NFTABLES': return 'Linux nftables Subsystem';
      case 'CISCO_ASA': return 'Cisco ASA Adaptive Security Appliance';
      case 'FORTINET': return 'Fortinet FortiGate REST Connector';
      case 'PALO_ALTO': return 'Palo Alto PAN-OS Security Integration';
      case 'PFSENSE': return 'pfSense pf Firewall Engine';
      case 'GENERIC_REST': return 'Generic Enterprise REST Firewall API';
    }
  }

  private formatBlockCommand(type: FirewallType, ip: string, reason: string): string {
    switch (type) {
      case 'WINDOWS_FIREWALL':
        return `netsh advfirewall firewall add rule name="AWM_BLOCK_${ip}" dir=in action=block remoteip=${ip} comment="${reason}"`;
      case 'LINUX_IPTABLES':
        return `iptables -A INPUT -s ${ip} -j DROP -m comment --comment "${reason}"`;
      case 'NFTABLES':
        return `nft add rule inet filter input ip saddr ${ip} drop comment "${reason}"`;
      case 'CISCO_ASA':
        return `access-list AWM_BLOCK_LIST line 1 extended deny ip host ${ip} any log`;
      case 'FORTINET':
        return `config firewall policy -> edit 9901 -> set srcaddr ${ip} -> set action deny -> end`;
      case 'PALO_ALTO':
        return `set security rules AWM-AUTO-DENY source ${ip} destination any action drop`;
      case 'PFSENSE':
        return `easyrule block wan ${ip}`;
      case 'GENERIC_REST':
        return `POST /api/v1/firewall/rules { action: "BLOCK", target: "${ip}", reason: "${reason}" }`;
    }
  }

  private formatUnblockCommand(type: FirewallType, ip: string): string {
    switch (type) {
      case 'WINDOWS_FIREWALL':
        return `netsh advfirewall firewall delete rule name="AWM_BLOCK_${ip}"`;
      case 'LINUX_IPTABLES':
        return `iptables -D INPUT -s ${ip} -j DROP`;
      case 'NFTABLES':
        return `nft delete rule inet filter input ip saddr ${ip} drop`;
      case 'CISCO_ASA':
        return `no access-list AWM_BLOCK_LIST extended deny ip host ${ip} any`;
      case 'FORTINET':
        return `config firewall policy -> delete 9901 -> end`;
      case 'PALO_ALTO':
        return `delete security rules AWM-AUTO-DENY source ${ip}`;
      case 'PFSENSE':
        return `easyrule unblock wan ${ip}`;
      case 'GENERIC_REST':
        return `DELETE /api/v1/firewall/rules?target=${ip}`;
    }
  }

