# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional key for OpenAI provider models.
OPENAI_API_KEY=""

# GROQ_API_KEY: Optional key for Groq LPU inference acceleration engine.
GROQ_API_KEY=""

# GROQ_MODEL: Groq LPU model selection (llama-3.3-70b-versatile | mixtral-8x7b-32768)
GROQ_MODEL="llama-3.3-70b-versatile"

# AI Operational Configuration
# AI_PROVIDER: gemini | local | openai | groq | deepseek | custom
AI_PROVIDER="gemini"

# AI_MODE: OFFLINE_ONLY | ONLINE_ONLY | HYBRID | ENTERPRISE_PRIVATE
AI_MODE="HYBRID"

# LOCAL_MODEL_PATH: Path to local quantized model binaries or air-gapped container weights
LOCAL_MODEL_PATH="/models/seclm-8b-q4.gguf"

# PRIVATE_AI_ENDPOINT: Endpoint for Enterprise Private VPC model service (Ollama / vLLM)
PRIVATE_AI_ENDPOINT="http://vllm-cybersec.internal.vpc:8000/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

