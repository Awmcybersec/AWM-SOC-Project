{
  "logging": {
    "level": "INFO",
    "logDirectory": "C:\\ProgramData\\AWM-AI-SOC-SENIOR\\logs",
    "files": {
      "serviceLog": "awm-service.log",
      "errorLog": "awm-error.log",
      "auditLog": "awm-audit.log",
      "siemIngestLog": "awm-siem.log"
    },
    "rotation": {
      "maxSizeBytes": 104857600,
      "maxBackups": 30,
